# =============================================================================
# 复制本文件为 .env 后填写；等号两侧不要加空格，值不要加引号
# =============================================================================

# 阿里云百炼密钥（必填，否则只能打开页面，无法调用千问）
DASHSCOPE_API_KEY=sk-你的百炼密钥

# 可选：默认 qwen-plus；需要更强推理时改成 qwen-max
DASHSCOPE_MODEL=qwen-plus

# 可选：项目数据根目录，默认 D:\projects
PM_PROJECTS_ROOT=D:\projects
